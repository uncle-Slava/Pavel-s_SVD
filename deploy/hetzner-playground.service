[Unit]
Description=SVD matrix playground (loopback only)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/svd-standalone-20261011
# The newer project .venv has CPU-only Torch. This existing environment has CUDA.
ExecStart=/root/svdbench/.venv/bin/python -m svdbench.playground.server --port 8765 --data-dir /root/svd-standalone-20261011/.playground
Environment=PYTHONPATH=/root/svd-research-20261011/vendor
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=4
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=multi-user.target
